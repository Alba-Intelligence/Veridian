-- allium: 3
-- 10-data-ingestion-and-synthetic.allium

-- Scope: How external and synthetic data enter Veridian (D-034, D-035).
-- Includes: the register of approved data sources and their terms, ingestion
--   runs by replaceable adapters, validation, expected publication and
--   staleness, source revisions, attribution, seeded synthetic generation
--   (market data and portfolios) and golden data sets.
-- Excludes:
--   - Versioning of what is ingested: ordinary input versions (01).
--   - Adapter and generator code: configuration releases (05).
--   - Payload meaning and validation logic: Julia (D-018).
-- Dependencies: 01, 02, 05.
--
-- Principles:
--   - Veridian slots into an existing organisation: every external source is
--     reached through an adapter that only produces input versions, so a bank
--     replaces free sources with its own feeds without platform change.
--   - No paid subscriptions in v1; a source is used only after its terms have
--     been checked and recorded (docs/design/data-sources.md).
--   - Synthetic data is reproducible: same generator code, parameters and seed
--     give byte-identical content hashes, and it is never production data.

-- Split (D-070): this file holds sources and ingestion; 10b-golden-sets golden
--   data sets and their sign-off; 10c-synthetic-data synthetic data.

use "./01-bitemporal-data.allium" as data
use "./05-configuration-release.allium" as cfg
use "./10b-golden-sets.allium" as gold
use "./10c-synthetic-data.allium" as syn

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

-- A provider and dataset Veridian may ingest, with the terms that allow it.
-- Internal systems of record (booking, position keeping, entity master) are
-- sources too (16); their terms are the bank's internal data agreements.
entity DataSource {
    name: String
    provider: String
    feed: market_data | trades | positions | hierarchy | parties | securities | ratings | pnl_adjustments
    -- The business owner who answers for the data, e.g. resolves breaks (16).
    data_owner: data/User
    terms_url: String
    terms_checked_at: Timestamp
    attribution_text: String
    allows_automated_access: Boolean
    allows_demonstration: Boolean
    -- Local time and zone by which a publication is expected, per business day.
    expected_by: String
    adapter_identity: data/User
    registered_by: data/User
    approval: pending | approved | suspended
    approved_by: data/User when approval = approved | suspended

    transitions approval {
        pending -> approved
        approved -> suspended
        suspended -> approved
    }

    usable: approval = approved and allows_automated_access
}

-- One retrieval by an adapter.
entity IngestionRun {
    source: DataSource
    started_at: Timestamp
    retrieval_ref: String
    outcome: fetching | recorded | invalid | unreachable
    versions_recorded: Integer
    problem: String when outcome = invalid | unreachable

    transitions outcome {
        fetching -> recorded
        fetching -> invalid
        fetching -> unreachable
        terminal: recorded, invalid, unreachable
    }
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

rule RegisterDataSource {
    when: DataSourceRegistered(steward, name, provider, feed, data_owner, terms_url, attribution_text, allows_automated_access, allows_demonstration, expected_by, adapter_identity)
    requires: data/permitted(steward, "source.register", name)
    requires: not exists DataSource{name: name}
    ensures: DataSource.created(
        name: name,
        provider: provider,
        feed: feed,
        data_owner: data_owner,
        terms_url: terms_url,
        terms_checked_at: now,
        attribution_text: attribution_text,
        allows_automated_access: allows_automated_access,
        allows_demonstration: allows_demonstration,
        expected_by: expected_by,
        adapter_identity: adapter_identity,
        registered_by: steward,
        approval: pending
    )
}

-- Terms are reviewed by someone other than the person who recorded them.
rule ApproveDataSource {
    when: DataSourceApproved(approver, source)
    requires: source.approval in {pending, suspended}
    requires: approver != source.registered_by
    requires: data/permitted(approver, "source.approve", source.name)
    requires: data/freshly_authenticated(approver)
    ensures:
        source.approval = approved
        source.approved_by = approver
}

-- E.g. the provider changes its terms: ingestion stops until re-approved.
rule SuspendDataSource {
    when: DataSourceSuspended(steward, source, reason)
    requires: source.approval = approved
    requires: data/permitted(steward, "source.suspend", source.name)
    ensures: source.approval = suspended
}

rule StartIngestion {
    when: IngestionStarted(adapter, source, retrieval_ref)
    requires: source.usable
    requires: adapter = source.adapter_identity
    ensures: IngestionRun.created(
        source: source,
        started_at: now,
        retrieval_ref: retrieval_ref,
        outcome: fetching,
        versions_recorded: 0
    )
}

-- Each retrieved item is validated by Julia against its schema (D-018)
-- before it is submitted as an input version carrying lineage_ref.
rule IngestionRecorded {
    when: IngestionCompleted(adapter, run, count)
    requires: run.outcome = fetching
    requires: adapter = run.source.adapter_identity
    ensures:
        run.outcome = recorded
        run.versions_recorded = count
}

-- Invalid content is never recorded; a person is told.
rule IngestionInvalid {
    when: IngestionRejected(adapter, run, problem)
    requires: run.outcome = fetching
    ensures:
        run.outcome = invalid
        run.problem = problem
        DataQualityAlert(source: run.source, problem: problem)
}

rule IngestionUnreachable {
    when: IngestionFailed(adapter, run, problem)
    requires: run.outcome = fetching
    ensures:
        run.outcome = unreachable
        run.problem = problem
        DataQualityAlert(source: run.source, problem: problem)
}

-- A publication that has not arrived by its expected time is reported; the
-- previous value is never silently carried forward.
rule PublicationOverdue {
    when: PublicationMissing(monitor, source, business_date)
    requires: source.approval = approved
    ensures: DataQualityAlert(source: source, problem: "publication overdue")
}

------------------------------------------------------------
-- Actor Declarations
------------------------------------------------------------

actor DataSteward {
    identified_by: data/User
}

actor SourceAdapter {
    identified_by: data/User
}

actor PublicationMonitor {
    identified_by: data/User
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface SourceGovernance {
    facing steward: DataSteward
    context source: DataSource

    exposes:
        source.name
        source.provider
        source.feed
        source.data_owner
        source.terms_url
        source.terms_checked_at
        source.attribution_text
        source.approval

    provides:
        DataSourceRegistered(steward, name, provider, feed, data_owner, terms_url, attribution_text, allows_automated_access, allows_demonstration, expected_by, adapter_identity)
        DataSourceApproved(steward, source) when source.approval in {pending, suspended}
        DataSourceSuspended(steward, source, reason) when source.approval = approved
        SyntheticDataRequested(steward, generator_code_hash, parameters_hash, seed, data_class)

    @guarantee AttributionTravelsWithResults
        -- Any screen, report or export showing results derived from a
        -- public source shows that source's attribution text and notices.
}

surface Ingestion {
    facing adapter: SourceAdapter
    context run: IngestionRun

    provides:
        IngestionStarted(adapter, source, retrieval_ref)
        IngestionCompleted(adapter, run, count) when run.outcome = fetching
        IngestionRejected(adapter, run, problem) when run.outcome = fetching
        IngestionFailed(adapter, run, problem) when run.outcome = fetching
}

surface PublicationMonitoring {
    facing monitor: PublicationMonitor

    provides:
        PublicationMissing(monitor, source, business_date)
}

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------

-- Resolved (D-042): source revisions (e.g. a republished SOFR) are recorded
-- at once as source corrections (01 RecordSourceCorrection) under the
-- source's own controls; runs that used the old value are flagged for review
-- (06).
-- Resolved (D-051): a golden set is signed off by the model validator and the
-- data owner, two different people, neither the author.
open question "Demonstrations to third parties: which sources may appear (allows_demonstration), pending the bank's legal review of each provider's terms?"
