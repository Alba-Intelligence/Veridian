-- allium: 3
-- 04-identity-access-audit.allium

-- Scope: Who may do what in Veridian, and the tamper-evident record of
--   everything anyone (person or service) did or tried to do (D-009).
-- Includes: users (people and service identities), roles granted over time,
--   the permitted(user, action, target) decision used by every other spec,
--   separation of duties, the hash-chained audit log and its readers.
-- Excludes:
--   - Authentication mechanics: an external OIDC identity provider proves who
--     a person is; this spec starts from an authenticated subject.
--   - Role-to-rights mapping: configuration as code (D-016); a role's actions
--     come from the tagged configuration release (black box role_allows).
--   - Audit storage technology and retention (D-005: configured later).
-- Dependencies: none (01-03 reference User and permitted as external).

-- Split (D-070): this file holds users, role grants, HR feed rules and actors;
--   04b-break-glass emergency access; 04c-audit-trail the audit log,
--   its signed checkpoints and auditor reads.

use "./04b-break-glass.allium" as bg
use "./04c-audit-trail.allium" as aud

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

enum Outcome { allowed | denied | failed }

-- A person (OIDC subject) or a service identity (batch schedules, data feeds,
-- worker pool). Every action in Veridian is attributed to exactly one User.
entity User {
    subject: String
    display_name: String
    kind: person | service
    -- A service identity has a named, responsible person (D-016).
    owner: User?
    created_at: Timestamp
    status: active | suspended | revoked
    suspended_at: Timestamp when status = suspended
    revoked_at: Timestamp when status = revoked

    transitions status {
        active -> suspended
        suspended -> active
        active -> revoked
        suspended -> revoked
        terminal: revoked
    }

    grants: RoleGrant with grantee = this
    active_grants: grants where state = in_force

    invariant ServiceHasOwner {
        kind = service implies owner != null
    }
}

-- A role held over a validity period. Roles and their rights are defined in
-- configuration (D-016); grants are data, so they are dated and approved.
entity RoleGrant {
    grantee: User
    role_name: String
    -- Entitlement scope (D-026): absent means all. Information barriers
    -- between desks are expressed through legal entity and book.
    legal_entity: String?
    book: String?
    valid_from: Timestamp
    valid_to: Timestamp?
    requested_by: User
    requested_at: Timestamp
    state: requested | in_force | withdrawn | declined
    granted_by: User when state = in_force | withdrawn
    granted_at: Timestamp when state = in_force | withdrawn
    withdrawn_at: Timestamp when state = withdrawn
    declined_by: User when state = declined

    transitions state {
        requested -> in_force
        requested -> declined
        in_force -> withdrawn
        terminal: withdrawn, declined
    }
}

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    -- Roles whose grants need a second person (four-eyes).
    privileged_roles: Set<String> = { "data_steward", "model_approver", "access_admin", "auditor" }
    -- Approvals need an authentication no older than this (D-026).
    step_up_window: Duration = 5.minutes
    break_glass_duration: Duration = 4.hours
    -- The first review level has this long; each escalation step after it
    -- has break_glass_escalation_step (D-051).
    break_glass_review_deadline: Duration = 1.day
    break_glass_escalation_step: Duration = 1.day
    checkpoint_interval: Duration = 1.day
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

rule RegisterPerson {
    when: PersonOnboarded(admin, subject, display_name)
    requires: permitted(admin, "user.onboard", subject)
    requires: not exists User{subject: subject}
    ensures: User.created(
        subject: subject,
        display_name: display_name,
        kind: person,
        owner: null,
        created_at: now,
        status: active
    )
}

rule RegisterServiceIdentity {
    when: ServiceIdentityCreated(admin, subject, display_name, owner)
    requires: permitted(admin, "user.onboard", subject)
    requires: owner.kind = person
    requires: owner.status = active
    requires: not exists User{subject: subject}
    ensures: User.created(
        subject: subject,
        display_name: display_name,
        kind: service,
        owner: owner,
        created_at: now,
        status: active
    )
}

rule SuspendUser {
    when: UserSuspended(admin, user)
    requires: user.status = active
    requires: admin != user
    requires: permitted(admin, "user.suspend", user.subject)
    ensures:
        user.status = suspended
        user.suspended_at = now
}

rule ReinstateUser {
    when: UserReinstated(admin, user)
    requires: user.status = suspended
    requires: admin != user
    requires: permitted(admin, "user.suspend", user.subject)
    ensures:
        user.status = active
        user.suspended_at = null
}

rule RevokeUser {
    when: UserRevoked(admin, user)
    requires: user.status in {active, suspended}
    requires: admin != user
    requires: permitted(admin, "user.revoke", user.subject)
    ensures:
        user.status = revoked
        user.revoked_at = now
}

rule RequestRoleGrant {
    when: RoleGrantRequested(requester, grantee, role_name, legal_entity?, book?, valid_from, valid_to?)
    requires: permitted(requester, "access.request", role_name)
    requires: grantee.status = active
    ensures: RoleGrant.created(
        grantee: grantee,
        role_name: role_name,
        legal_entity: legal_entity,
        book: book,
        valid_from: valid_from,
        valid_to: valid_to,
        requested_by: requester,
        requested_at: now,
        state: requested
    )
}

-- Separation of duties: nobody grants a role to themselves; privileged roles
-- need an approver other than the requester.
rule ApproveRoleGrant {
    when: RoleGrantApproved(approver, grant)
    requires: grant.state = requested
    requires: approver != grant.grantee
    requires: grant.role_name in config.privileged_roles implies approver != grant.requested_by
    requires: permitted(approver, "access.approve", grant.role_name)
    requires: freshly_authenticated(approver, config.step_up_window)
    ensures:
        grant.state = in_force
        grant.granted_by = approver
        grant.granted_at = now
}

rule DeclineRoleGrant {
    when: RoleGrantDeclined(approver, grant)
    requires: grant.state = requested
    requires: permitted(approver, "access.approve", grant.role_name)
    ensures:
        grant.state = declined
        grant.declined_by = approver
}

rule WithdrawRoleGrant {
    when: RoleGrantWithdrawn(admin, grant)
    requires: grant.state = in_force
    requires: permitted(admin, "access.withdraw", grant.role_name)
    ensures:
        grant.state = withdrawn
        grant.withdrawn_at = now
}

-- HR feed (D-026): a leaver is suspended and loses every grant; a mover loses
-- every grant and re-requests what the new job needs.
rule HrLeaver {
    when: HrLeaverNotified(feed, user)
    requires: permitted(feed, "hr.leaver", user.subject)
    requires: user.status = active
    ensures:
        user.status = suspended
        user.suspended_at = now
        for g in user.active_grants:
            g.state = withdrawn
            g.withdrawn_at = now
}

rule HrMover {
    when: HrMoverNotified(feed, user)
    requires: permitted(feed, "hr.mover", user.subject)
    ensures:
        for g in user.active_grants:
            g.state = withdrawn
            g.withdrawn_at = now
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

invariant UniqueSubject {
    for a in Users:
        for b in Users:
            a != b implies a.subject != b.subject
}

invariant NoSelfGrant {
    for g in RoleGrants:
        g.state in {in_force, withdrawn} implies g.granted_by != g.grantee
}

------------------------------------------------------------
-- Actor Declarations
------------------------------------------------------------

actor AccessAdministrator {
    identified_by: User where status = active
}

actor Auditor {
    identified_by: User where status = active
}

actor Operator {
    identified_by: User where status = active and kind = person
}

actor HrFeed {
    identified_by: User where status = active and kind = service
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface AccessAdministration {
    facing admin: AccessAdministrator
    context grant: RoleGrant

    exposes:
        grant.grantee.display_name
        grant.role_name
        grant.legal_entity
        grant.book
        grant.state
        grant.valid_from
        grant.valid_to

    provides:
        PersonOnboarded(admin, subject, display_name)
        ServiceIdentityCreated(admin, subject, display_name, owner)
        UserSuspended(admin, user)
        UserReinstated(admin, user)
        UserRevoked(admin, user)
        RoleGrantRequested(admin, grantee, role_name, legal_entity?, book?, valid_from, valid_to?)
        RoleGrantApproved(admin, grant) when grant.state = requested
        RoleGrantDeclined(admin, grant) when grant.state = requested
        RoleGrantWithdrawn(admin, grant) when grant.state = in_force
}

surface HumanResourcesFeed {
    facing feed: HrFeed

    provides:
        HrLeaverNotified(feed, user)
        HrMoverNotified(feed, user)

    @guarantee FeedEventsAudited
        -- Every leaver and mover notification is recorded in the audit chain
        -- with the users and grants it changed.
}

------------------------------------------------------------
-- Deferred Specifications
------------------------------------------------------------

-- permitted(user, action, target): true only if user.status = active and some
-- grant in user.active_grants is valid now, its role allows the action
-- (role_allows, from the configuration release) and its legal entity and book cover the
-- target. Every evaluation emits ActionAttempted with its outcome.
-- latest_audit_event, next_sequence, hash_of, chain_hash: black boxes; a
-- single writer orders the chain.
-- next_review_level(level): peer -> head_of_function -> on_call -> on_call.
-- reviewer_may_review(reviewer, level, role_name): permitted(reviewer, the
--   level's review action, role_name), or the action of a higher level.
--   The on-call rota is the configured one (D-039).

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------

-- Resolved (D-026): legal-entity and book scoping; break-glass with
-- next-day review; reads audited for production and regulatory data only;
-- step-up authentication for approvals; daily signed, externally anchored
-- checkpoints; HR feed for leavers and movers.
-- Resolved (D-042): the bank's legal entity and finance master is
-- authoritative, ingested as bitemporal reference data (16); a grant on a
-- legal entity or desk covers its books as of the access check.
-- Resolved (D-051): break-glass review escalates by role, peer then head of
-- function then the on-call rota, one step per day (configuration), and the
-- user of break-glass is never a reviewer.
