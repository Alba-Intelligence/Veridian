-- allium: 3
-- 07d-job-dispatch.allium

-- Scope: The bounded queue, assignment of jobs to workers, bundles and their
--   ledger commit, worker recycling and worker death. Part of the Julia worker
--   spec (07-julia-workers); see its header for the principles.
-- Dependencies: 01, 02, 05, 06, 07, 07b.

use "./01-bitemporal-data.allium" as data
use "./02-calculation-graph.allium" as graph
use "./02c-payload-retention.allium" as ret
use "./05-configuration-release.allium" as cfg
use "./06-batch-scheduling.allium" as batch
use "./07-julia-workers.allium" as core
use "./07b-compute-hosts.allium" as hosts
use "./02b-node-execution.allium" as exec

------------------------------------------------------------
-- Rules
------------------------------------------------------------

-- Bounded queue: when full, dispatch is held back and nodes stay pending in
-- the queue's place (backpressure), never dropped.
rule EnqueueJob {
    when: exec/ComputationDispatched(node)
    requires: queued_count() < core/config.queue_capacity
    ensures: core/JobTicket.created(
        node: node,
        purpose: computation,
        priority: priority_of(node),
        enqueued_at: now,
        phase: queued
    )
}

-- A purged payload to rebuild takes the same queue, at the lowest priority
-- above development (D-030). Not held back when the queue is full: nothing
-- raises the event again and the payload's timeout starts only at assignment
-- (D-063), so a dropped one would hang. At most one recomputation exists per
-- purged payload (D-062), which bounds the extra load.
rule EnqueueRecomputation {
    when: ret/RecomputationDispatched(payload)
    ensures: core/JobTicket.created(
        node: payload.node,
        purpose: recomputation,
        payload: payload,
        priority: recomputation_priority(),
        enqueued_at: now,
        phase: queued
    )
}

-- Highest priority first, then oldest; only to a worker whose build can run
-- the nodes' models. An idle worker takes a bundle: up to config.bundle_size
-- tickets, fewer when the queue holds fewer (D-044).
rule AssignJob {
    -- model: bundled_dispatch.takeBundle
    when: worker: core/WorkerProcess.lifecycle becomes idle
    let tickets = next_tickets_for(worker.build, core/config.bundle_size)
    requires: tickets.count > 0
    ensures:
        worker.lifecycle = busy
        for ticket in tickets:
            ticket.phase = assigned
            ticket.worker = worker
            if ticket.purpose = computation:
                exec/ComputationAssigned(node: ticket.node, worker: worker.identity, environment: environment_of(worker))
            else:
                ret/RecomputationAssigned(payload: ticket.payload, worker: worker.identity, environment: environment_of(worker))
}

rule JobSucceeds {
    -- model: bundled_dispatch.receive
    when: WorkerReportsSuccess(reporter, ticket, result_ref, result_hash)
    requires: ticket.phase = assigned
    let worker = ticket.worker
    requires: worker.identity = reporter
    requires: worker.lifecycle = busy
    ensures:
        ticket.phase = reported
        ticket.outcome = succeeded
        ticket.result_ref = result_ref
        ticket.result_hash = result_hash
        worker.jobs_done = worker.jobs_done + 1
}

-- A rejection is reported like a result and recorded with the bundle.
rule JobRejected {
    when: WorkerReportsRejection(reporter, ticket, reason)
    requires: ticket.phase = assigned
    let worker = ticket.worker
    requires: worker.identity = reporter
    requires: worker.lifecycle = busy
    ensures:
        ticket.phase = reported
        ticket.outcome = rejected
        ticket.rejection_reason = reason
        worker.jobs_done = worker.jobs_done + 1
}

-- Once every ticket of the bundle is reported, one ledger transaction records
-- them all; a node counts as complete (or rejected) in the graph only when
-- that transaction commits (D-044, D-056).
rule BundleCommitted {
    -- model: bundled_dispatch.commitBundle
    when: ticket: core/JobTicket.phase becomes reported
    let worker = ticket.worker
    requires: worker.lifecycle = busy
    requires: worker.held.count = 0
    ensures:
        for t in worker.reported_pending:
            t.phase = finished
            if t.purpose = computation and t.outcome = succeeded:
                exec/ComputationSucceeded(worker: worker.identity, node: t.node, result_ref: t.result_ref, result_hash: t.result_hash)
            else if t.purpose = computation:
                exec/ComputationRejected(worker: worker.identity, node: t.node, reason: t.rejection_reason, log_excerpt: log_tail(worker))
            else if t.outcome = succeeded:
                ret/RematerialisationCompleted(worker: worker, payload: t.payload, result_ref: t.result_ref, result_hash: t.result_hash)
            else:
                -- A recomputation the worker rejects is lost like a crash: the
                -- retry count and cap of 02c apply.
                ret/RecomputationCrashed(worker: worker.identity, payload: t.payload, reason: t.rejection_reason, log_excerpt: log_tail(worker))
}

-- The worker is free once nothing of its bundle is held or waiting.
rule BundleFinished {
    -- model: bundled_dispatch.commitBundle
    when: ticket: core/JobTicket.phase becomes finished
    let worker = ticket.worker
    requires: worker.lifecycle = busy
    requires: worker.held.count = 0
    requires: worker.reported_pending.count = 0
    ensures: WorkerFreed(worker: worker)
}

-- A freed worker takes the next job, or is recycled after its quota.
rule FreeWorker {
    when: WorkerFreed(worker)
    requires: worker.lifecycle = busy
    ensures:
        if worker.jobs_done >= core/config.max_jobs_per_worker or worker.host.presence = retiring:
            worker.lifecycle = draining
        else:
            worker.lifecycle = idle
}

rule DrainedWorkerStops {
    when: worker: core/WorkerProcess.lifecycle becomes draining
    ensures:
        worker.lifecycle = stopped
        worker.stopped_at = now
        worker.stop_reason = "recycled"
}

-- Process exit, out-of-memory kill or kill after timeout: the tickets the
-- worker still held and those it reported but whose bundle did not commit are
-- crashed, each on its own; the graph decides per node whether to retry (02,
-- ComputationCrashes). Nodes recorded by an earlier committed bundle stay
-- complete (D-044, D-056).
rule WorkerExitReported {
    -- model: bundled_dispatch.procDies
    when: WorkerExited(supervisor, worker, reason)
    ensures: WorkerGone(worker: worker, reason: reason)
}

rule WorkerDies {
    -- model: bundled_dispatch.declareLost
    when: WorkerGone(worker, reason)
    requires: worker.lifecycle = busy
    requires: worker.held.count > 0 or worker.reported_pending.count > 0
    ensures:
        worker.lifecycle = stopped
        worker.stopped_at = now
        worker.stop_reason = reason
        for ticket in worker.held + worker.reported_pending:
            ticket.phase = finished
            if ticket.purpose = computation:
                exec/ComputationCrashed(worker: worker.identity, node: ticket.node, reason: reason, log_excerpt: log_tail(worker))
            else:
                ret/RecomputationCrashed(worker: worker.identity, payload: ticket.payload, reason: reason, log_excerpt: log_tail(worker))
}

rule MemoryLimitExceeded {
    when: hosts/WorkerOverMemory(supervisor, worker, rss_mb)
    requires: worker.lifecycle = busy
    requires: rss_mb > core/config.worker_memory_limit_mb
    ensures: WorkerExited(supervisor: supervisor, worker: worker, reason: "memory limit")
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

invariant BundleWithinLimit {
    -- model: bundled_dispatch.bundleWithinLimit
    for w in core/WorkerProcesses:
        w.held.count <= core/config.bundle_size
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface JobChannel {
    facing julia: JuliaWorker
    context ticket: core/JobTicket where phase = assigned

    exposes:
        ticket.node.calc_id
        ticket.node.model.code_hash
        ticket.node.as_of
        ticket.node.inputs

    provides:
        WorkerReady(julia, worker)
        WorkerReportsSuccess(julia, ticket, result_ref, result_hash)
        WorkerReportsRejection(julia, ticket, reason)

    contracts:
        demands WorkerIsolation
        demands JobGranularity
        demands graph/DeterministicComputation
        demands TestDoubles
        demands core/HashOwnership
}
